+                Node[Link[i].node1].newQual[p] += w;
+                Link[i].totalLoad[p] += w * tStep;
+            }
+        }
+        if ( qDn > 0.0 ) Node[Link[i].node2].qualInflow += qDn;
+        if ( qUp < 0.0 ) Node[Link[i].node1].qualInflow -= qUp;
