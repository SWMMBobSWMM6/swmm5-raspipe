+    // --- RASPIPE: a conduit has a different flow at each end, and water can
+    //     leave through either end or both
+    if ( RasPipe && raspipe_endFlows(i, &qUp, &qDn) )
+    {
+        for (p = 0; p < Nobjects[POLLUT]; p++)
